\newcommand{\knowledgelink}[2]{\hyperref[#1]{#2}}
\newcommand{\problemid}[1]{%
  \texorpdfstring{\textcolor{CrashBlue}{\textbf{#1}}}{#1}%
}
\newcommand{\printproblemid}[1]{\textbf{#1}}
\NewDocumentCommand{\problemstart}{O{0.31}}{\Needspace{#1\textheight}}
\newcommand{\score}[1]{\textbf{#1 分}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\C}{\mathbb{C}}

% Store each mock statement once, then render a print copy and a solved copy.
\NewDocumentCommand{\DeclareMockProblem}{m +m +m +m}{
  \csgdef{mock@#1@statement}{#2}
  \csgdef{mock@#1@answer}{#3}
  \csgdef{mock@#1@idea}{#4}
}

\NewDocumentCommand{\PrintMockProblem}{m m}{
  \subsection*{#2\quad\printproblemid{#1}}
  \csuse{mock@#1@statement}
}

\NewDocumentCommand{\SolveMockProblem}{m m}{
  \problemstart
  \subsection{#2（\problemid{#1}）}
  \paragraph{题目}
  \csuse{mock@#1@statement}
  \begin{examanswer}
    \csuse{mock@#1@answer}
  \end{examanswer}
  \begin{idea}
    \csuse{mock@#1@idea}
  \end{idea}
}

\NewDocumentEnvironment{mockpaper}{m m}{
  \clearpage
  \section{#1}
  \begingroup
  \noindent\textbf{#2}\par\medskip
}{
  \par\medskip
  \noindent\textit{本页到此结束。请在限时完成后再翻阅答案区。}
  \endgroup
}
